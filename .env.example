# Токен бота от @BotFather в Telegram
TELEGRAM_BOT_TOKEN=

# Ключ API Anthropic (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Telegram ID людей, которым можно пользоваться ботом (через запятую).
# Свой ID узнаешь, написав боту /start — он ответит твоим ID, если доступ ещё закрыт.
ALLOWED_USER_IDS=

# Твой часовой пояс (нужен для напоминаний), например Europe/Moscow
TIMEZONE=Europe/Moscow

# Необязательно
# CLAUDE_MODEL=claude-opus-5-5     # можно взять дешевле, например claude-sonnet-5-5
# CLAUDE_EFFORT=medium             # low | medium | high | xhigh | max
# DB_PATH=data/assistant.db
# HISTORY_MESSAGES=30              # сколько последних реплик помнить
